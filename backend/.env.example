# Required (use Neon's pooled connection string for the deployed API)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Optional: leave unset if Redis is not deployed yet.
REDIS_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,https://bus-tracking-system-kohl-six.vercel.app
PORT=4000
NODE_ENV=development
LOCATION_LIVE_THRESHOLD_SECONDS=15
LOCATION_DELAYED_THRESHOLD_SECONDS=60
