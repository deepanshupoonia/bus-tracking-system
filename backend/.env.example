# Required (use Neon's pooled connection string for the deployed API)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Required for driver GPS updates and all latest-location reads. Paste the Redis
# Cloud TLS URL here (normally starts with rediss://); never commit the value.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,https://bus-tracking-system-kohl-six.vercel.app
# Optional wildcard allow-list for Vercel preview deployments. Keep this
# scoped to this project; do not use a broad *.vercel.app value.
CORS_ORIGIN_PATTERN=https://bus-tracking-system-*.vercel.app
PORT=4000
NODE_ENV=development
LOCATION_LIVE_THRESHOLD_SECONDS=15
LOCATION_DELAYED_THRESHOLD_SECONDS=60
